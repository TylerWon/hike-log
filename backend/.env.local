# Current environment (local, staging, production)
ENV=local

# Database credentials
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=hike_log

# AWS variables
# Credentials
AWS_ACCESS_KEY_ID=localstack
AWS_SECRET_ACCESS_KEY=localstack
# Overrides the default AWS API endpoint to point to the "localstack" Docker service.
AWS_ENDPOINT_URL="http://localstack:4566"
# AWS API endpoint accessible outside of Docker. Used when the host needs to access localstack (ex. in presigned S3 URLs).
AWS_EXTERNAL_ENDPOINT_URL="http://localhost:4566"
AWS_S3_BUCKET_NAME="hike-log"
AWS_REGION="us-east-1"

# Auth variables
# bcrypt hash of admin password (password is "admin" in local environment). Escapes $ with an additional $ symbol.
ADMIN_PASSWORD_HASH=$$2a$$10$$haTJ.11uqjdIRUD4yxMSt.HfJiOL9.WjyjH1D2C.qv8okP0c0wuXC 
# Random string used to sign session cookies
SESSION_SECRET=vDuTmQE8HJj_SsRT32y8Wz8yH97FoRCT5VUiNJlfsGI 

FRONTEND_URL="http://localhost:5173"
