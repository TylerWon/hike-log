# Current environment (local, staging, production)
ENV=local

# Database credentials
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=hike_log

# AWS credentials
AWS_ACCESS_KEY_ID=localstack
AWS_SECRET_ACCESS_KEY=localstack

# AWS settings
AWS_REGION="us-east-1"
# This AWS endpoint is only accessible in Docker because it uses the "localstack" service as its hostname
AWS_ENDPOINT_URL="http://localstack:4566"
# This AWS endpoint is accessible outside Docker
AWS_PUBLIC_ENDPOINT_URL="http://localhost:4566"
AWS_S3_BUCKET_NAME="hike-log"

# Auth variables
# bcrypt hash of admin password (password is "admin" in local environment)
ADMIN_PASSWORD_HASH=$$2a$$10$$haTJ.11uqjdIRUD4yxMSt.HfJiOL9.WjyjH1D2C.qv8okP0c0wuXC 
